<Page
    x:Class="RssReader.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RssReader.Models"
    xmlns:converters="using:RssReader.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullSafeImageConverter x:Key="NullSafeImageConverter" />

        <!-- カードのボタンスタイル (ホバー・クリック対応カード) -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- ツールバー / コマンド領域 -->
            <RowDefinition Height="Auto" />
            <!-- プログレスバー -->
            <RowDefinition Height="Auto" />
            <!-- エラー通知 -->
            <RowDefinition Height="Auto" />
            <!-- メインコンテンツ (記事カードグリッド) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上部ヘッダー / コントロールバー -->
        <Grid Grid.Row="0" Padding="20,14,20,10" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- フィード選択ドロップダウン -->
            <ComboBox
                Grid.Column="0"
                MinWidth="200"
                ItemsSource="{x:Bind ViewModel.FeedSources, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedFeedSource, Mode=TwoWay}"
                DisplayMemberPath="Name"
                PlaceholderText="フィードを選択"
                VerticalAlignment="Center" />

            <!-- 更新ボタン -->
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadFeedsCommand}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="フィードを今すぐ更新">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="更新" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 並び替えメニューボタン -->
            <DropDownButton
                Grid.Column="2"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="記事の並び替え">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock Text="並び替え" VerticalAlignment="Center" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem
                            Text="新着順（新しい順）"
                            Command="{x:Bind ViewModel.ChangeSortCommand}"
                            CommandParameter="NewestFirst">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="古い順"
                            Command="{x:Bind ViewModel.ChangeSortCommand}"
                            CommandParameter="OldestFirst">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="タイトル順 (A→Z / 昇順)"
                            Command="{x:Bind ViewModel.ChangeSortCommand}"
                            CommandParameter="TitleAscending" />
                        <MenuFlyoutItem
                            Text="タイトル順 (Z→A / 降順)"
                            Command="{x:Bind ViewModel.ChangeSortCommand}"
                            CommandParameter="TitleDescending" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- フィード追加ボタン (Flyout) -->
            <Button Grid.Column="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="フィード追加" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="320" Spacing="12">
                            <TextBlock Text="新しいRSSフィードを追加" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBox
                                Header="フィード名 (省略可)"
                                Text="{x:Bind ViewModel.NewFeedName, Mode=TwoWay}"
                                PlaceholderText="例: TechCrunch" />
                            <TextBox
                                Header="フィードURL (RSS / Atom)"
                                Text="{x:Bind ViewModel.NewFeedUrl, Mode=TwoWay}"
                                PlaceholderText="https://..." />
                            <Button
                                Content="追加して取得"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.AddFeedCommand}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- フィード削除ボタン (確認Flyout) -->
            <Button
                Grid.Column="4"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind ViewModel.CanRemoveSelectedFeed, Mode=OneWay}"
                ToolTipService.ToolTip="選択中のフィードを削除">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="フィード削除" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="RemoveFeedFlyout">
                        <StackPanel Width="280" Spacing="12">
                            <TextBlock Text="フィードを削除しますか？" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedFeedSource.Name, Mode=OneWay}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="キャンセル" Click="OnRemoveFeedCancelClick" />
                                <Button
                                    Content="削除"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.RemoveSelectedFeedCommand}"
                                    Click="OnRemoveFeedConfirmClick" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- 検索ボックス -->
            <AutoSuggestBox
                Grid.Column="5"
                QueryIcon="Find"
                PlaceholderText="記事タイトルやキーワードで絞り込み..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                VerticalAlignment="Center"
                Margin="12,0,0,0" />

            <!-- ステータス・取得件数 -->
            <TextBlock
                Grid.Column="6"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                FontSize="12"
                Margin="8,0,0,0" />
        </Grid>

        <!-- 読み込み中プログレスバー -->
        <ProgressBar
            Grid.Row="1"
            IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            Height="3"
            HorizontalAlignment="Stretch" />

        <StackPanel Grid.Row="2">
            <!-- フィード一覧の読み込み失敗通知 -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStorageWarning, Mode=TwoWay}"
                Severity="Warning"
                Title="フィード一覧の読み込みエラー"
                Message="{x:Bind ViewModel.StorageWarning, Mode=OneWay}"
                Margin="20,8,20,0" />

            <!-- エラーバー -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="フィード取得エラー"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Margin="20,8,20,0" />
        </StackPanel>

        <!-- 記事グリッド表示 (レスポンシブなUniformGridLayout) -->
        <ScrollViewer Grid.Row="3" Padding="20,16,20,20">
            <Grid>
                <!-- 記事カード一覧 -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayedItems, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="320"
                            MinItemHeight="360"
                            MinColumnSpacing="16"
                            MinRowSpacing="16"
                            ItemsJustification="Start"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:FeedItem">
                            <!-- カードコンテナ (全体クリックで記事を開く) -->
                            <Button
                                Style="{StaticResource CardButtonStyle}"
                                Tag="{x:Bind Link}"
                                Click="OnCardClick">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- アイキャッチ画像エリア -->
                                        <RowDefinition Height="150" />
                                        <!-- コンテンツエリア -->
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- アイキャッチ画像 (画像あり時) -->
                                    <Border
                                        Grid.Row="0"
                                        CornerRadius="9,9,0,0"
                                        Visibility="{x:Bind HasImage, Mode=OneTime, Converter={StaticResource BoolToVis}}">
                                        <Image
                                            Source="{x:Bind ImageUrl, Mode=OneTime, Converter={StaticResource NullSafeImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <!-- プレースホルダー画像 (画像なし時) -->
                                    <Border
                                        Grid.Row="0"
                                        CornerRadius="9,9,0,0"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                        Visibility="{x:Bind HasImage, Mode=OneTime, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <FontIcon Glyph="&#xE8A1;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind SourceFeedName, Mode=OneTime}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                FontWeight="SemiBold"
                                                FontSize="12"
                                                Opacity="0.8" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 記事情報コンテンツ -->
                                    <Grid Grid.Row="1" Padding="14,12,14,12">
                                        <Grid.RowDefinitions>
                                            <!-- ソース元バッジ ＆ 日時 -->
                                            <RowDefinition Height="Auto" />
                                            <!-- タイトル -->
                                            <RowDefinition Height="Auto" />
                                            <!-- 本文抜粋 -->
                                            <RowDefinition Height="*" />
                                            <!-- フッター (読むボタン) -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- ヘッダーメタ情報 (配信元バッジ + 日時) -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 配信元名バッジ -->
                                            <Border
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2">
                                                <TextBlock
                                                    Text="{x:Bind SourceFeedName, Mode=OneTime}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>

                                            <!-- 公開日時 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xEC92;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind FormattedPublishDate, Mode=OneTime}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- タイトル (2行省略) -->
                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{x:Bind Title, Mode=OneTime}"
                                            FontWeight="Bold"
                                            FontSize="14"
                                            LineHeight="20"
                                            MaxLines="2"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Margin="0,0,0,8" />

                                        <!-- 概要 (3行省略) -->
                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{x:Bind Summary, Mode=OneTime}"
                                            FontSize="12"
                                            LineHeight="17"
                                            MaxLines="3"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Margin="0,0,0,10"
                                            VerticalAlignment="Top" />

                                        <!-- フッターリンク表示 -->
                                        <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                            <TextBlock
                                                Text="記事をブラウザで開く"
                                                FontSize="11"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" />
                                            <FontIcon
                                                Glyph="&#xE8A7;"
                                                FontSize="12"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 記事が0件のときの表示 (空状態 / ガイド) -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,60,0,0"
                    Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <FontIcon Glyph="&#xE890;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="表示できる記事がありません"
                        FontSize="16"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="上の「更新」ボタンを押すか、フィードを選択してください。"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button
                        Content="今すぐ更新"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadFeedsCommand}"
                        Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
